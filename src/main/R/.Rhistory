ggplot(filter(brandenburg_combined, period_filter), aes(x = date)) +
geom_line(aes(y = daily_new_ref, color = "Refdatum")) +
geom_line(aes(y = daily_new_melde, color = "Meldedatum")) +
labs(title = "Comparison of Daily New Cases (Brandenburg)", x = "Date", y = "Daily Cases", color = "Date Type") +
theme_minimal()
# smooth the curves with rolling 7 day incidence per 100.000
incidence_data_br <- brandenburg_combined %>%
mutate(
incidence_ref = rollmean(daily_new_ref, 7, fill = NA, align = "right") / 3782202 * 1e5,
incidence_melde = rollmean(daily_new_melde, 7, fill = NA, align = "right") / 3782202 * 1e5
)
ggplot(filter(incidence_data_br, period_filter), aes(x = date)) +
